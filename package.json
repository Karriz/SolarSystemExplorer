{
  "name": "solar-system-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "moon:check-soft-boundaries": "node scripts/check-moon-soft-boundaries.mjs",
    "moon:build-contours": "sh scripts/terrain-python.sh scripts/build-moon-vectors.py --colors 10 --contours",
    "moon:test-contours": "sh scripts/terrain-python.sh scripts/test-moon-contours.py",
    "moon:check-contours": "node scripts/check-moon-contours.mjs",
    "moon:build-vectors": "sh scripts/terrain-python.sh scripts/build-moon-vectors.py",
    "moon:check-vectors": "node scripts/check-moon-vectors.mjs",
    "terrain:check-moon-stability": "node scripts/check-moon-lod-stability.mjs",
    "terrain:check-moon": "node scripts/check-moon-global.mjs",
    "terrain:fetch-moon": "python3 scripts/fetch-moon-global.py",
    "terrain:fetch-wac": "python3 scripts/fetch-wac-global.py",
    "terrain:build-wac": "sh scripts/terrain-python.sh scripts/build-wac-global.py",
    "terrain:test-pipeline": "sh scripts/terrain-python.sh scripts/test-moon-build.py",
    "terrain:build": "sh scripts/terrain-python.sh scripts/build-terrain.py",
    "terrain:check-color-uv": "node --experimental-strip-types scripts/check-earth-color-uv.mjs",
    "terrain:check-continuity": "node scripts/check-terrain-continuity.mjs",
    "terrain:check-heights": "node --experimental-strip-types scripts/check-earth-heights.mjs",
    "terrain:benchmark": "node scripts/benchmark-terrain-pilot.mjs",
    "terrain:pilot": "sh scripts/terrain-python.sh scripts/build-terrain-pilot.py",
    "terrain:validate": "sh scripts/terrain-python.sh scripts/validate-terrain.py",
    "test": "node --experimental-strip-types tests/run.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --mode app",
    "preview": "vite preview",
    "terrain:check-decoder": "node scripts/check-terrain-decoder.mjs",
    "terrain:check-wac": "node scripts/check-wac-global.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "lucide-react": "^1.34.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
