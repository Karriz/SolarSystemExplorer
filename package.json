{
  "name": "solar-system-explorer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "moon:build-color": "sh scripts/terrain-python.sh scripts/build-moon-color.py",
    "moon:check-color": "node scripts/check-moon-color.mjs",
    "hillshade:build": "sh scripts/terrain-python.sh scripts/build-global-hillshade.py",
    "hillshade:validate": "sh scripts/terrain-python.sh scripts/validate-global-hillshade.py",
    "hillshade:test-pipeline": "sh scripts/terrain-python.sh scripts/test-global-hillshade.py",
    "hillshade:check-edges": "node scripts/check-hillshade-page-edges.mjs",
    "surfaces:check-detail": "node scripts/check-surface-detail.mjs",
    "surfaces:check-planets": "node scripts/check-planet-surfaces.mjs",
    "surfaces:check-global": "node scripts/check-global-surfaces.mjs",
    "mars:build-color": "sh scripts/terrain-python.sh scripts/build-mars-color.py",
    "mars:check-color": "node scripts/check-mars-color.mjs",
    "mars:build-hillshade": "sh scripts/terrain-python.sh scripts/build-global-hillshade.py --bodies mars",
    "mars:check-hillshade": "node scripts/check-global-surfaces.mjs",
    "moon:check-cube": "node scripts/check-moon-cube.mjs",
    "moon:check-cube-colors": "node scripts/check-moon-cube-colors.mjs",
    "mars:check-cube": "CUBE_BODY=mars node scripts/check-moon-cube.mjs",
    "mars:build-detail": "node scripts/build-mars-detail.mjs",
    "mars:check-cube-colors": "CUBE_BODY=mars node scripts/check-moon-cube-colors.mjs",
    "mars:fetch-terrain": "python3 scripts/fetch-mars-hrsc.py",
    "mars:build-terrain": "sh scripts/terrain-python.sh scripts/build-terrain.py --bodies mars --offline --workers 8",
    "mars:check-terrain-upgrade": "node scripts/check-mars-terrain-upgrade.mjs",
    "mars:check-source-samples": "sh scripts/terrain-python.sh scripts/check-mars-source-samples.py",
    "mars:test-pipeline": "sh scripts/terrain-python.sh scripts/test-mars-build.py",
    "moon:check-soft-boundaries": "node scripts/check-moon-soft-boundaries.mjs",
    "moon:build-contours": "sh scripts/terrain-python.sh scripts/build-moon-vectors.py --colors 10 --contours",
    "moon:test-contours": "sh scripts/terrain-python.sh scripts/test-moon-contours.py",
    "moon:check-contours": "node scripts/check-moon-contours.mjs",
    "moon:build-vectors": "sh scripts/terrain-python.sh scripts/build-moon-vectors.py",
    "moon:check-vectors": "node scripts/check-moon-vectors.mjs",
    "mars:build-mocwa-color": "sh scripts/terrain-python.sh scripts/build-mars-mocwa-color.py --years 25,26,27,28 --longitudes 34,124,214,304 --output .terrain-cache/mars-moc-wa/mocwa-multiseason.png",
    "mars:build-vectors": "sh scripts/terrain-python.sh scripts/build-moon-vectors.py --source .terrain-cache/mars-moc-wa/mocwa-multiseason.png --source-label 'MOC-WA Red and Blue 2023, four Mars-year seasonal composite' --labels-cache .terrain-cache/mars-mocwa-labels-10.npz --contour-cache .terrain-cache/mars-mocwa-contours.npz --output public/mars-vectors --colors 10 --contours",
    "terrain:check-moon-stability": "node scripts/check-moon-lod-stability.mjs",
    "terrain:check-moon": "node scripts/check-moon-global.mjs",
    "terrain:fetch-moon": "python3 scripts/fetch-moon-global.py",
    "terrain:fetch-wac": "python3 scripts/fetch-wac-global.py",
    "terrain:build-wac": "sh scripts/terrain-python.sh scripts/build-wac-global.py",
    "terrain:test-pipeline": "sh scripts/terrain-python.sh scripts/test-moon-build.py",
    "terrain:build": "sh scripts/terrain-python.sh scripts/build-terrain.py",
    "terrain:check-color-uv": "node --experimental-strip-types scripts/check-earth-color-uv.mjs",
    "terrain:check-continuity": "node scripts/check-terrain-continuity.mjs",
    "terrain:check-heights": "node --experimental-strip-types scripts/check-earth-heights.mjs",
    "terrain:benchmark": "node scripts/benchmark-terrain-pilot.mjs",
    "terrain:pilot": "sh scripts/terrain-python.sh scripts/build-terrain-pilot.py",
    "terrain:validate": "sh scripts/terrain-python.sh scripts/validate-terrain.py",
    "test": "node --experimental-strip-types tests/run.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:app": "tsc -b && vite build --mode app",
    "preview": "vite preview",
    "terrain:check-decoder": "node scripts/check-terrain-decoder.mjs",
    "terrain:check-wac": "node scripts/check-wac-global.mjs",
    "mercury:build-detail": "node scripts/build-mercury-detail.mjs",
    "moon:build-detail": "node scripts/build-moon-detail.mjs",
    "mercury:build-color": "sh scripts/terrain-python.sh scripts/build-mercury-color.py",
    "mercury:check-color-source": "sh scripts/terrain-python.sh scripts/check-mercury-color-source.py",
    "mercury:check-color": "node scripts/check-mercury-color.mjs",
    "mercury:build-hillshade": "sh scripts/terrain-python.sh scripts/build-global-hillshade.py --bodies mercury",
    "mercury:check-source-samples": "sh scripts/terrain-python.sh scripts/check-mercury-source-samples.py",
    "mercury:check-cube": "CUBE_BODY=mercury node scripts/check-moon-cube.mjs",
    "venus:build-color": "sh scripts/terrain-python.sh scripts/build-venus-color.py",
    "venus:build-detail": "node scripts/build-venus-detail.mjs",
    "venus:build-hillshade": "sh scripts/terrain-python.sh scripts/build-global-hillshade.py --bodies venus",
    "venus:check-cube": "CUBE_BODY=venus node scripts/check-moon-cube.mjs",
    "venus:check-source-samples": "sh scripts/terrain-python.sh scripts/check-venus-source-samples.py",
    "venus:check-color": "node scripts/check-venus-color.mjs",
    "venus:check-views": "node scripts/check-venus-views.mjs",
    "earth:build-surface": "sh scripts/terrain-python.sh scripts/build-earth-surface.py",
    "earth:build-detail": "node scripts/build-earth-detail.mjs",
    "earth:check-surfaces": "node scripts/check-earth-surfaces.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "^1.5.0",
    "@mapbox/vector-tile": "^3.0.0",
    "lucide-react": "^1.34.0",
    "pbf": "^5.1.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "playwright": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.6"
  }
}
